{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=XFrameworkDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "xframework.events",
    "ExchangeType": "topic",
    "Durable": true,
    "AutoDelete": false,
    "PublisherConfirms": true,
    "ConnectionTimeoutSeconds": 10,
    "AutomaticRecoveryEnabled": true,
    "NetworkRecoveryIntervalSeconds": 5,

    "Retry": {
      "DelaysInSeconds": [
        5,
        30,
        120,
        600,
        1800
      ]
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
