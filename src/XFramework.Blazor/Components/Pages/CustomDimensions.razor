@page "/custom-dimensions"
@rendermode InteractiveServer

@using XFramework.Application.Contracts.Dimensions
@using XFramework.Application.Contracts.Dtos
@using XFramework.Domain.Dimensions
@using XFramework.Domain.SharedKernel
@inject ICustomDimensionAppService CustomDimensionAppService

<PageTitle>Custom Dimensions</PageTitle>

<h1>Custom Dimensions</h1>

<button class="btn btn-primary mb-3" @onclick="OpenCreateModal">
    Create Custom Dimension
</button>

@if (_customDimensions is null)
{
    <p>Loading...</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Dimension Key</th>
                <th>Status</th>
                <th>Required</th>
                <th>Allow Hierarchy</th>
                <th>Parent</th>
                <th>Attributes</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cd in _customDimensions)
            {
                <tr>
                    <td>@cd.Code</td>
                    <td>@cd.Name</td>
                    <td>@cd.DimensionKey</td>
                    <td>
                        <span class="badge @GetStatusBadge(cd.Status)">@cd.Status</span>
                    </td>
                    <td>@(cd.IsRequired ? "Yes" : "No")</td>
                    <td>@(cd.AllowHierarchy ? "Yes" : "No")</td>
                    <td>@cd.ParentDimensionCode ?? "-"</td>
                    <td>@GetAttributesString(cd.Attributes)</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditModal(cd)">Edit</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(cd.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- Create/Edit Modal -->
@if (_showModal)
{
    <div class="modal fade show" style="display: block; background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editingCustomDimension != null ? "Edit Custom Dimension" : "Create Custom Dimension")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Code</label>
                        <input type="text" class="form-control" @bind="_customDimensionForm.Code" @bind:event="oninput" disabled="@(_editingCustomDimension != null)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" @bind="_customDimensionForm.Name" @bind:event="oninput" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" @bind="_customDimensionForm.Description" @bind:event="oninput"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Dimension Key</label>
                        <input type="text" class="form-control" @bind="_customDimensionForm.DimensionKey" @bind:event="oninput" disabled="@(_editingCustomDimension != null)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select class="form-select" @bind="_customDimensionForm.Status" @bind:event="onchange">
                            @foreach (var s in Enum.GetValues<DimensionStatus>())
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Is Required</label>
                            <input type="checkbox" class="form-check-input" @bind="_customDimensionForm.IsRequired" @bind:event="onchange" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Allow Hierarchy</label>
                            <input type="checkbox" class="form-check-input" @bind="_customDimensionForm.AllowHierarchy" @bind:event="onchange" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Parent Dimension</label>
                        <select class="form-select" @bind="_customDimensionForm.ParentDimensionIdString" @bind:event="onchange">
                            <option value="">None</option>
                            @foreach (var cd in _customDimensionsForParent)
                            {
                                <option value="@cd.Id">@cd.Code - @cd.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Attributes (JSON)</label>
                        <textarea class="form-control" rows="4" @bind="_customDimensionForm.AttributesJson" @bind:event="oninput" placeholder='{"key": "value"}'></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveCustomDimension">@(_editingCustomDimension != null ? "Update" : "Create")</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (_showDeleteConfirm)
{
    <div class="modal fade show" style="display: block; background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this custom dimension?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteCustomDimension">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<CustomDimensionDto>? _customDimensions;
    private List<CustomDimensionDto> _customDimensionsForParent = new();
    private bool _showModal;
    private bool _showDeleteConfirm;
    private CustomDimensionDto? _editingCustomDimension;
    private Guid _deleteId;
    private CustomDimensionForm _customDimensionForm = new();

    private class CustomDimensionForm
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string DimensionKey { get; set; } = string.Empty;
        public DimensionStatus Status { get; set; } = DimensionStatus.Active;
        public bool IsRequired { get; set; } = false;
        public bool AllowHierarchy { get; set; } = false;
        public string? ParentDimensionIdString { get; set; }
        public Guid? ParentDimensionId => Guid.TryParse(ParentDimensionIdString, out var g) ? g : null;
        public string AttributesJson { get; set; } = "{}";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var result = await CustomDimensionAppService.GetListAsync(new PagedAndSortedRequestDto { SkipCount = 0, MaxResultCount = 100 });
        _customDimensions = result.Items;
        _customDimensionsForParent = result.Items.Where(c => c.Status == DimensionStatus.Active && c.AllowHierarchy).ToList();
    }

    private void OpenCreateModal()
    {
        _editingCustomDimension = null;
        _customDimensionForm = new CustomDimensionForm();
        _showModal = true;
    }

    private void OpenEditModal(CustomDimensionDto cd)
    {
        _editingCustomDimension = cd;
        _customDimensionForm = new CustomDimensionForm
        {
            Code = cd.Code,
            Name = cd.Name,
            Description = cd.Description,
            DimensionKey = cd.DimensionKey,
            Status = cd.Status,
            IsRequired = cd.IsRequired,
            AllowHierarchy = cd.AllowHierarchy,
            ParentDimensionIdString = cd.ParentDimensionId?.ToString(),
            AttributesJson = System.Text.Json.JsonSerializer.Serialize(cd.Attributes)
        };
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
        _editingCustomDimension = null;
        _customDimensionForm = new CustomDimensionForm();
    }

    private async Task SaveCustomDimension()
    {
        try
        {
            var attributes = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(_customDimensionForm.AttributesJson) ?? new();

            if (_editingCustomDimension != null)
            {
                var updateDto = new CustomDimensionUpdateDto
                {
                    Name = _customDimensionForm.Name,
                    Description = _customDimensionForm.Description,
                    Status = _customDimensionForm.Status,
                    IsRequired = _customDimensionForm.IsRequired,
                    AllowHierarchy = _customDimensionForm.AllowHierarchy,
                    ParentDimensionId = _customDimensionForm.ParentDimensionId,
                    Attributes = attributes
                };
                await CustomDimensionAppService.UpdateAsync(_editingCustomDimension.Id, updateDto);
            }
            else
            {
                var createDto = new CustomDimensionCreateDto
                {
                    Code = _customDimensionForm.Code,
                    Name = _customDimensionForm.Name,
                    Description = _customDimensionForm.Description,
                    DimensionKey = _customDimensionForm.DimensionKey,
                    IsRequired = _customDimensionForm.IsRequired,
                    AllowHierarchy = _customDimensionForm.AllowHierarchy,
                    ParentDimensionId = _customDimensionForm.ParentDimensionId,
                    Attributes = attributes
                };
                await CustomDimensionAppService.CreateAsync(createDto);
            }
            CloseModal();
            await LoadData();
        }
        catch
        {
            // TODO: Show error notification
        }
    }

    private void ConfirmDelete(Guid id)
    {
        _deleteId = id;
        _showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        _showDeleteConfirm = false;
        _deleteId = Guid.Empty;
    }

    private async Task DeleteCustomDimension()
    {
        await CustomDimensionAppService.DeleteAsync(_deleteId);
        _showDeleteConfirm = false;
        _deleteId = Guid.Empty;
        await LoadData();
    }

    private string GetStatusBadge(DimensionStatus status) => status switch
    {
        DimensionStatus.Active => "bg-success",
        DimensionStatus.Inactive => "bg-secondary",
        DimensionStatus.Closed => "bg-danger",
        _ => "bg-secondary"
    };

    private string GetAttributesString(Dictionary<string, string>? attributes)
    {
        if (attributes == null || attributes.Count == 0) return "-";
        return string.Join(", ", attributes.Select(kvp => $"{kvp.Key}: {kvp.Value}"));
    }
}