@page "/login"
@using Microsoft.AspNetCore.Identity
@using XFramework.EntityFrameworkCore.Identity
@using Radzen
@using Radzen.Blazor
@inject SignInManager<XFrameworkIdentityUser> SignInManager
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject HttpClient HttpClient

<PageTitle>@L.Get("Login")</PageTitle>

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="card shadow-sm" style="width: 100%; max-width: 420px;">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <h3 class="mb-1">@L.Get("WelcomeBack")</h3>
                <p class="text-muted">@L.Get("SignInToAccount")</p>
            </div>

            <form @onsubmit="OnSubmit" style="gap: 1rem;">
                <div class="mb-3">
                    <RadzenLabel Text="@L.Get("UsernameOrEmail")" For="Username" />
                    <input type="text" class="form-control" @bind-value="_username" placeholder="@L.Get("EnterUsernameOrEmail")" required />
                </div>

                <div class="mb-3">
                    <RadzenLabel Text="@L.Get("Password")" For="Password" />
                    <input type="password" class="form-control" @bind-value="_password" placeholder="@L.Get("EnterPassword")" required />
                </div>

                <div class="mb-3 d-flex align-items-center justify-content-between">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" @bind-value="_rememberMe" id="RememberMe" />
                        <label class="form-check-label" for="RememberMe">@L.Get("RememberMe")</label>
                    </div>
                    <a href="/forgot-password" class="text-decoration-none small">@L.Get("ForgotPassword")</a>
                </div>

                <button type="submit" class="btn btn-primary w-100" disabled="@_isLoading">@L.Get("SignIn")</button>
            </form>

            <div class="text-center mt-3">
                <p class="text-muted small">
                    @L.Get("DontHaveAccount")
                    <a href="/register" class="text-decoration-none">@L.Get("Register")</a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] private ILocalizationService L { get; set; } = default!;

    private bool _isLoading;
    private string _username = "";
    private string _password = "";
    private bool _rememberMe;

    protected override async Task OnInitializedAsync()
    {
        if (HttpContextAccessor.HttpContext?.User.Identity?.IsAuthenticated == true)
        {
            HttpContextAccessor.HttpContext.Response.Redirect("/");
        }
        await base.OnInitializedAsync();
    }

    private async Task OnSubmit()
    {
        _isLoading = true;
        try
        {
            var response = await HttpClient.PostAsJsonAsync("/api/auth/login", new
            {
                username = _username,
                password = _password,
                rememberMe = _rememberMe
            });

            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/", forceLoad: true);
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<LoginError>();
                if (error?.Error == "AccountLocked")
                {
                    NotificationService.Notify(NotificationSeverity.Error, L.Get("Error"), L.Get("AccountLocked"));
                }
                else
                {
                    NotificationService.Notify(NotificationSeverity.Error, L.Get("Error"), L.Get("InvalidCredentials"));
                }
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class LoginError
    {
        public string? Error { get; set; }
    }
}