@page "/items"
@rendermode InteractiveServer

@using XFramework.Application.Contracts.Inventory
@using XFramework.Application.Contracts.Dtos
@using XFramework.Domain.Inventory
@using XFramework.Domain.SharedKernel
@using Radzen
@using Radzen.Blazor
@inject IItemAppService ItemAppService
@inject IWarehouseAppService WarehouseAppService
@inject DialogService DialogService
@inject NotificationService NotificationService

<PageTitle>Items</PageTitle>

<RadzenCard>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Items</h3>
        <RadzenButton Text="Create Item" Icon="add" Click="@(args => OpenCreateModal())" Style="width: auto;" />
    </div>

    <RadzenDataGrid @ref="_grid" Data="@_items" TItem="ItemDto" PageSize="10" AllowPaging="true" AllowSorting="true" AllowFiltering="true" FilterMode="FilterMode.Simple" ShowPagingSummary="true" Dense="true">
        <Columns>
            <RadzenDataGridColumn TItem="ItemDto" Property="Code" Title="Code" Frozen="true" Width="120px" />
            <RadzenDataGridColumn TItem="ItemDto" Property="Name" Title="Name" Width="200px" />
            <RadzenDataGridColumn TItem="ItemDto" Property="Type" Title="Type" Width="130px">
                <Template Context="item">
                    <RadzenBadge Text="@item.Type.ToString()" Style="@GetTypeBadge(item.Type)" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ItemDto" Property="Status" Title="Status" Width="130px">
                <Template Context="item">
                    <RadzenBadge Text="@item.Status.ToString()" Style="@GetStatusBadge(item.Status)" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ItemDto" Property="CostingMethod" Title="Costing Method" Width="140px" />
            <RadzenDataGridColumn TItem="ItemDto" Property="StandardCost" Title="Standard Cost" Width="140px">
                <Template Context="item">
                    @item.StandardCost.Amount @item.StandardCost.Currency
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ItemDto" Property="IsStocked" Title="Stocked" Width="80px">
                <Template Context="item">
                    <RadzenIcon Icon="@(item.IsStocked ? "check_circle" : "cancel")" Style="@(item.IsStocked ? "color: green;" : "color: red;")" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="ItemDto" Title="Actions" Width="120px" Frozen="true" Sortable="false" Filterable="false">
                <Template Context="item">
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="edit" Size="ButtonSize.Small" Click="@(args => OpenEditModal(item))" />
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="delete" Size="ButtonSize.Small" Click="@(args => ConfirmDelete(item.Id))" Style="color: red;" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

    <div class="text-center mt-3" style="color: #6c757d;" @if (_items != null && _items.Count == 0) { <text>style="display:block;"</text> } else { <text>style="display:none;"</text> }>
        <em>No items found. Click "Create Item" to add one.</em>
    </div>
</RadzenCard>

@code {
    private RadzenDataGrid<ItemDto>? _grid;
    private IReadOnlyList<ItemDto>? _items;
    private List<WarehouseDto> _warehouses = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var result = await ItemAppService.GetListAsync(new PagedAndSortedRequestDto { SkipCount = 0, MaxResultCount = 100 });
        _items = result.Items;

        var whResult = await WarehouseAppService.GetListAsync(new PagedAndSortedRequestDto { SkipCount = 0, MaxResultCount = 100 });
        _warehouses = whResult.Items.ToList();
    }

    private async Task OpenCreateModal()
    {
        var parameters = new Dictionary<string, object?>
        {
            ["Warehouses"] = _warehouses,
            ["IsEdit"] = false
        };
        await DialogService.OpenAsync<ItemDialog>("Create Item", parameters, new DialogOptions { Width = "700px", Height = "800px", Resizable = true, Draggable = true });
        await LoadData();
        await _grid?.Reload();
    }

    private async Task OpenEditModal(ItemDto item)
    {
        var parameters = new Dictionary<string, object?>
        {
            ["Item"] = item,
            ["Warehouses"] = _warehouses,
            ["IsEdit"] = true
        };
        await DialogService.OpenAsync<ItemDialog>("Edit Item", parameters, new DialogOptions { Width = "700px", Height = "800px", Resizable = true, Draggable = true });
        await LoadData();
        await _grid?.Reload();
    }

    private async Task ConfirmDelete(Guid id)
    {
        var confirmed = await DialogService.Confirm("Are you sure you want to delete this item?", "Confirm Delete", new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" });
        if (confirmed == true)
        {
            await ItemAppService.DeleteAsync(id);
            NotificationService.Notify(NotificationSeverity.Success, "Success", "Item deleted successfully");
            await LoadData();
            await _grid?.Reload();
        }
    }

    private string GetStatusBadge(ItemStatus status) => status switch
    {
        ItemStatus.Active => "background-color: #28a745; color: white;",
        ItemStatus.Inactive => "background-color: #6c757d; color: white;",
        ItemStatus.Discontinued => "background-color: #dc3545; color: white;",
        ItemStatus.Blocked => "background-color: #ffc107; color: black;",
        _ => "background-color: #6c757d; color: white;"
    };

    private string GetTypeBadge(ItemType type) => type switch
    {
        ItemType.Product => "background-color: #007bff; color: white;",
        ItemType.Service => "background-color: #17a2b8; color: white;",
        ItemType.RawMaterial => "background-color: #6f42c1; color: white;",
        ItemType.Consumable => "background-color: #fd7e14; color: white;",
        ItemType.FixedAsset => "background-color: #20c997; color: white;",
        ItemType.Kit => "background-color: #e83e8c; color: white;",
        _ => "background-color: #6c757d; color: white;"
    };
}