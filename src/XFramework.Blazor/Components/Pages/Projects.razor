@page "/projects"
@rendermode InteractiveServer

@using XFramework.Application.Contracts.Dimensions
@using XFramework.Application.Contracts.Dtos
@using XFramework.Domain.Dimensions
@using XFramework.Domain.SharedKernel
@inject IProjectAppService ProjectAppService

<PageTitle>Projects</PageTitle>

<h1>Projects</h1>

<button class="btn btn-primary mb-3" @onclick="OpenCreateModal">
    Create Project
</button>

@if (_projects is null)
{
    <p>Loading...</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Status</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Manager</th>
                <th>Customer</th>
                <th>Budget</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in _projects)
            {
                <tr>
                    <td>@p.Code</td>
                    <td>@p.Name</td>
                    <td>
                        <span class="badge @GetStatusBadge(p.Status)">@p.Status</span>
                    </td>
                    <td>@p.StartDate.ToString("yyyy-MM-dd")</td>
                    <td>@p.EndDate?.ToString("yyyy-MM-dd") ?? "-"</td>
                    <td>@p.ManagerId?.ToString() ?? "-"</td>
                    <td>@p.CustomerId?.ToString() ?? "-"</td>
                    <td>@p.Budget.Amount @p.Budget.Currency</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditModal(p)">Edit</button>
                        @if (p.Status != DimensionStatus.Closed)
                        {
                            <button class="btn btn-sm btn-outline-warning" @onclick="() => ConfirmClose(p.Id)">Close</button>
                        }
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(p.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- Create/Edit Modal -->
@if (_showModal)
{
    <div class="modal fade show" style="display: block; background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editingProject != null ? "Edit Project" : "Create Project")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Code</label>
                        <input type="text" class="form-control" @bind="_projectForm.Code" @bind:event="oninput" disabled="@(_editingProject != null)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" @bind="_projectForm.Name" @bind:event="oninput" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" @bind="_projectForm.Description" @bind:event="oninput"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select class="form-select" @bind="_projectForm.Status" @bind:event="onchange">
                            @foreach (var s in Enum.GetValues<DimensionStatus>())
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Start Date</label>
                            <input type="date" class="form-control" @bind="_projectForm.StartDate" @bind:event="onchange" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">End Date</label>
                            <input type="date" class="form-control" @bind="_projectForm.EndDate" @bind:event="onchange" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Manager Id</label>
                        <input type="text" class="form-control" @bind="_projectForm.ManagerIdString" @bind:event="oninput" placeholder="GUID" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Customer Id</label>
                        <input type="text" class="form-control" @bind="_projectForm.CustomerIdString" @bind:event="oninput" placeholder="GUID" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Budget Amount</label>
                            <input type="number" step="0.01" class="form-control" @bind="_projectForm.BudgetAmount" @bind:event="oninput" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Budget Currency</label>
                            <select class="form-select" @bind="_projectForm.BudgetCurrency" @bind:event="onchange">
                                @foreach (var c in Enum.GetValues<Currency>())
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveProject">@(_editingProject != null ? "Update" : "Create")</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (_showDeleteConfirm)
{
    <div class="modal fade show" style="display: block; background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this project?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteProject">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Close Confirmation Modal -->
@if (_showCloseConfirm)
{
    <div class="modal fade show" style="display: block; background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Close</h5>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to close this project?</p>
                    <div class="mb-3">
                        <label class="form-label">Actual End Date</label>
                        <input type="date" class="form-control" @bind="_closeActualEndDate" @bind:event="onchange" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelClose">Cancel</button>
                    <button class="btn btn-warning" @onclick="CloseProject">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<ProjectDto>? _projects;
    private bool _showModal;
    private bool _showDeleteConfirm;
    private bool _showCloseConfirm;
    private ProjectDto? _editingProject;
    private Guid _deleteId;
    private Guid _closeId;
    private DateTime _closeActualEndDate = DateTime.Today;
    private ProjectForm _projectForm = new();

    private class ProjectForm
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public DimensionStatus Status { get; set; } = DimensionStatus.Active;
        public DateTime StartDate { get; set; } = DateTime.Today;
        public DateTime? EndDate { get; set; }
        public string? ManagerIdString { get; set; }
        public Guid? ManagerId => Guid.TryParse(ManagerIdString, out var g) ? g : null;
        public string? CustomerIdString { get; set; }
        public Guid? CustomerId => Guid.TryParse(CustomerIdString, out var g) ? g : null;
        public decimal? BudgetAmount { get; set; }
        public Currency? BudgetCurrency { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _projectForm.StartDate = DateTime.Today;
        _projectForm.EndDate = DateTime.Today.AddMonths(6);
        await LoadData();
    }

    private async Task LoadData()
    {
        var result = await ProjectAppService.GetListAsync(new PagedAndSortedRequestDto { SkipCount = 0, MaxResultCount = 100 });
        _projects = result.Items;
    }

    private void OpenCreateModal()
    {
        _editingProject = null;
        _projectForm = new ProjectForm
        {
            StartDate = DateTime.Today,
            EndDate = DateTime.Today.AddMonths(6)
        };
        _showModal = true;
    }

    private void OpenEditModal(ProjectDto p)
    {
        _editingProject = p;
        _projectForm = new ProjectForm
        {
            Code = p.Code,
            Name = p.Name,
            Description = p.Description,
            Status = p.Status,
            StartDate = p.StartDate,
            EndDate = p.EndDate,
            ManagerIdString = p.ManagerId?.ToString(),
            CustomerIdString = p.CustomerId?.ToString(),
            BudgetAmount = p.Budget.Amount,
            BudgetCurrency = p.Budget.Currency
        };
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
        _editingProject = null;
        _projectForm = new ProjectForm();
    }

    private async Task SaveProject()
    {
        try
        {
            var budget = new MoneyDto
            {
                Amount = _projectForm.BudgetAmount ?? 0,
                Currency = _projectForm.BudgetCurrency ?? Currency.IRR
            };

            if (_editingProject != null)
            {
                var updateDto = new ProjectUpdateDto
                {
                    Name = _projectForm.Name,
                    Description = _projectForm.Description,
                    Status = _projectForm.Status,
                    StartDate = _projectForm.StartDate,
                    EndDate = _projectForm.EndDate,
                    ManagerId = _projectForm.ManagerId,
                    CustomerId = _projectForm.CustomerId,
                    Budget = budget
                };
                await ProjectAppService.UpdateAsync(_editingProject.Id, updateDto);
            }
            else
            {
                var createDto = new ProjectCreateDto
                {
                    Code = _projectForm.Code,
                    Name = _projectForm.Name,
                    Description = _projectForm.Description,
                    StartDate = _projectForm.StartDate,
                    EndDate = _projectForm.EndDate,
                    ManagerId = _projectForm.ManagerId,
                    CustomerId = _projectForm.CustomerId,
                    Budget = budget
                };
                await ProjectAppService.CreateAsync(createDto);
            }
            CloseModal();
            await LoadData();
        }
        catch
        {
            // TODO: Show error notification
        }
    }

    private void ConfirmDelete(Guid id)
    {
        _deleteId = id;
        _showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        _showDeleteConfirm = false;
        _deleteId = Guid.Empty;
    }

    private async Task DeleteProject()
    {
        await ProjectAppService.DeleteAsync(_deleteId);
        _showDeleteConfirm = false;
        _deleteId = Guid.Empty;
        await LoadData();
    }

    private void ConfirmClose(Guid id)
    {
        _closeId = id;
        _closeActualEndDate = DateTime.Today;
        _showCloseConfirm = true;
    }

    private void CancelClose()
    {
        _showCloseConfirm = false;
        _closeId = Guid.Empty;
    }

    private async Task CloseProject()
    {
        await ProjectAppService.CloseAsync(_closeId, _closeActualEndDate);
        _showCloseConfirm = false;
        _closeId = Guid.Empty;
        await LoadData();
    }

    private string GetStatusBadge(DimensionStatus status) => status switch
    {
        DimensionStatus.Active => "bg-success",
        DimensionStatus.Inactive => "bg-secondary",
        DimensionStatus.Closed => "bg-danger",
        _ => "bg-secondary"
    };
}